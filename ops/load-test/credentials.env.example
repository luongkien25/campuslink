# credentials.env.example - Mau file credential cho workload.sh
# Sao chep thanh credentials.env VA KHONG commit file do vao Git.
# File nay (.example) an toan de commit.

# API key cua Shlink (lay tu admin panel hoac env SHLINK_API_KEY tren app VM)
SHLINK_API_KEY=REPLACE_SHLINK_API_KEY

# Base URL cho redirect (short domain)
SHLINK_BASE=https://s.44-198-215-187.sslip.io

# Admin endpoint (REST API)
SHLINK_ADMIN=https://s.44-198-215-187.sslip.io

# Short code da ton tai trong Shlink de dung lam fixture
# Cach tao: tren app VM chay:
#   curl -s -X POST -H "X-Api-Key: <key>" -H "Content-Type: application/json" \
#        -d '{"longUrl":"https://example.com/fixture-1","customSlug":"tv4fix1"}' \
#        https://s.44-198-215-187.sslip.io/rest/v3/short-urls
# Liet ke nhieu slug cach nhau boi dau cach:
FIXTURE_SHORT_CODES="REPLACE_SLUG1 REPLACE_SLUG2 REPLACE_SLUG3"
