# CampusLink - hop dong cau hinh container shlinkio/shlink:5.1.8 (SRS muc 4.3, TV3 -> TV2)
# Tren app VM: chep thanh /opt/campuslink/shlink.env (khong commit file that).
# Khong co secret trong file nay. Secret chi di qua bien *_FILE tro toi file trong /run/secrets.
# Da kiem voi ma nguon v5.1.8 (02/11/2026, TV3):
#  - Shlink doc bien thuong TRUOC, roi moi doc *_FILE (EnvVars::loadFromEnv): KHONG dat DB_PASSWORD/REDIS_SERVERS thuong.
#  - Noi dung file secret duoc trim, nen dong xuong dong cuoi file khong sao.
#  - PORT, WEB_WORKER_NUM, TASK_WORKER_NUM do RoadRunner doc truc tiep (.rr.yml), khong ho tro *_FILE (khong can).

DEFAULT_DOMAIN=s.44-198-215-187.sslip.io
IS_HTTPS_ENABLED=true
PORT=8080

DB_DRIVER=postgres
DB_HOST=10.20.0.10
DB_PORT=5432
DB_NAME=shlink
DB_USER=shlink
DB_PASSWORD_FILE=/run/secrets/db_password

# File chua 1 dong: tcp://default:<mat-khau-urlencode>@10.20.0.10:6379
# Shlink (shlink-common RedisFactory) tu urldecode user/password trong URI.
REDIS_SERVERS_FILE=/run/secrets/redis_servers
CACHE_NAMESPACE=campuslink-v5
REDIS_PUB_SUB_ENABLED=true

MERCURE_ENABLED=false
RABBITMQ_ENABLED=false
AUTO_RESOLVE_TITLES=false
SKIP_INITIAL_GEOLITE_DOWNLOAD=true
REDIRECT_STATUS_CODE=302

# Diem xuat phat cho guest 1 vCPU/2 GiB, chua phai cau hinh da do
WEB_WORKER_NUM=1
TASK_WORKER_NUM=1
MEMORY_LIMIT=256M

TIMEZONE=UTC
LOGS_FORMAT=json
CORS_ALLOW_ORIGIN=https://admin.44-198-215-187.sslip.io
TRUSTED_PROXIES=1
