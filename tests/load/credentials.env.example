# credentials.env.example - Mau file credential cho tests/load/ va tests/smoke/
# Sao chep thanh credentials.env VA KHONG commit file do vao Git (.gitignore da chan *.env).

# API key cua Shlink (doc tu file, khong dua vao argv)
SHLINK_API_KEY=REPLACE_SHLINK_API_KEY

# Base URL cho redirect (short domain)
SHLINK_BASE=https://s.44-198-215-187.sslip.io

# Admin endpoint (REST API) va Web Client UI
SHLINK_ADMIN=https://s.44-198-215-187.sslip.io
SHLINK_ADMIN_UI=https://admin.44-198-215-187.sslip.io

# 5 short code fixture da ton tai trong Shlink (doi chieu H5)
FIXTURE_SHORT_CODES="tv4fix1 tv4fix2 tv4fix3 tv4fix4 tv4fix5"
