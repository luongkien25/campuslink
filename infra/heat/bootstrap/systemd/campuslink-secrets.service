[Unit]
Description=CampusLink core secrets (ADR-10)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
BindsTo=docker.service
PartOf=docker.service
ConditionPathExists=/etc/campuslink/bootstrap.json

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/campuslink/bootstrap/fetch_secrets.py
TimeoutStartSec=180
StandardOutput=journal
StandardError=journal
