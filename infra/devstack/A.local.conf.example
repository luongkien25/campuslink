# A.local.conf.example - Lab TV1 ban 1.1, muc 5.2 (controller + compute + gateway + storage)
# Dat tai /opt/stack/devstack/local.conf tren A (user stack), chmod 600.
# TV2 review truoc stack.sh. Truoc khi chay: grep -n 'REPLACE_' local.conf phai rong.
# Mat khau: ngau nhien, dai, chi chu+so; cung service credentials voi B.
# VG Cinder "stack-volumes-lvmdriver-1" phai DA TON TAI tren dia EBS raw 30GiB (Lab 4.2).
# CANH BAO: khong chay lai stack.sh tren cum co du lieu. Moi lan chay: DROP moi DB OpenStack, xoa DB OVN,
#   lvremove LV trong VG Cinder, mkfs lai swift.img, xoa image Glance. Chi chay lai khi chua tao tai nguyen.
#   Khong dung unstack.sh/clean.sh (vgremove VG Cinder tren dia EBS).
# Lam NGAY SAU stack.sh, truoc khi co du lieu (chi tiet: docs/troubleshooting.md, "Da biet truoc"):
#  - LVM: cuoi stack.sh DevStack ghi global_filter trong /etc/lvm/lvm.conf theo TEN nvme luc cai
#    (dong co "# from devstack"). Ten nvme co the doi sau stop/start -> doi thanh
#    global_filter = [ "a|^/dev/nvme[0-9]+n1$|", "r|.*|" ]  # campuslink   roi vgscan; vgs.
#  - Swift: dong swift.img trong /etc/fstab (DevStack ghi) khong co nofail -> them nofail, kiem findmnt --verify.
#  - n-cpu dung truoc libvirt-guests khi tat may: drop-in [Unit] After=libvirt-guests.service (A va B).
#  - Moi lan chay lai stack.sh: fstab them 1 dong swift.img nua va lvm.conf them 1 dong global_filter nua
#    (DevStack khong xoa duoc dong cu) -> giu 1 dong moi loai.
#  Ca 3 muc deu chua thu tren cum: thu tren A, ghi ket qua vao evidence G1.
# Kiem nhanh truoc stack.sh (phai ra 0, 1, 1, 1):
#   grep -v '^#' local.conf | grep -c REPLACE_
#   grep -c '^enable_service octavia o-api o-hk o-da$' local.conf
#   grep -c '^GNOCCHI_ARCHIVE_POLICY=ceilometer-high-rate$' local.conf
#   grep -c '^default_provider_driver=ovn$' local.conf

[[local|localrc]]
HOST_IP=10.11.0.10
SERVICE_HOST=10.11.0.10
HOST_IP_IFACE=REPLACE_WITH_A_ENI_INTERFACE
ADMIN_PASSWORD=REPLACE_ADMIN_ALNUM_SECRET
DATABASE_PASSWORD=REPLACE_DB_ALNUM_SECRET
RABBIT_PASSWORD=REPLACE_RABBIT_ALNUM_SECRET
SERVICE_PASSWORD=REPLACE_SERVICE_ALNUM_SECRET
LOGFILE=/opt/stack/logs/stack.sh.log
LOG_COLOR=False
LOGDAYS=7
API_WORKERS=2
LIBVIRT_TYPE=kvm
IPV4_ADDRS_SAFE_TO_USE=10.21.0.0/24
FIXED_RANGE=10.21.0.0/24
FLOATING_RANGE=172.24.4.0/24
PUBLIC_NETWORK_GATEWAY=172.24.4.1
Q_FLOATING_ALLOCATION_POOL=start=172.24.4.100,end=172.24.4.200
Q_AGENT=ovn
Q_ML2_PLUGIN_MECHANISM_DRIVERS=ovn,logger
Q_ML2_PLUGIN_TYPE_DRIVERS=local,flat,vlan,geneve
Q_ML2_TENANT_NETWORK_TYPE=geneve
ENABLE_CHASSIS_AS_GW=True
OVN_L3_CREATE_PUBLIC_NETWORK=True
OVN_BUILD_FROM_SOURCE=False
# Khong dat PUBLIC_INTERFACE thanh ENI AWS.
disable_service tempest
# Cinder backend: VG that must already exist on the raw EBS disk.
enable_service c-api c-sch c-vol
CINDER_ENABLED_BACKENDS=lvm:lvmdriver-1
VOLUME_GROUP_NAME=stack-volumes
# Swift lab; 1 replica on one host is NOT HA.
enable_service s-proxy s-object s-container s-account
SWIFT_REPLICAS=1
SWIFT_HASH=REPLACE_SWIFT_ALNUM_SECRET
SWIFT_LOOPBACK_DISK_SIZE=5G
# Heat / Octavia OVN / telemetry.
enable_plugin heat https://opendev.org/openstack/heat stable/2026.1
OCTAVIA_NODE=api
DISABLE_AMP_IMAGE_BUILD=True
enable_plugin octavia https://opendev.org/openstack/octavia stable/2026.1
enable_plugin ovn-octavia-provider https://opendev.org/openstack/ovn-octavia-provider stable/2026.1
# Plugin octavia chi chay khi bat dich vu ten "octavia" (if is_service_enabled $OCTAVIA). Thieu -> stack.sh loi
# "tee: /etc/octavia/octavia.conf: No such file or directory" o pha post-config (gap that 24/10/2026).
enable_service octavia o-api o-hk o-da
disable_service o-cw o-hm
CEILOMETER_BACKENDS=gnocchi
CEILOMETER_PIPELINE_INTERVAL=60
# Archive policy gan cho MOI metric Ceilometer. Mac dinh DevStack la ceilometer-low (chi mean, 5 phut)
# -> alarm granularity 60 khong bao gio co du lieu. ceilometer-high-rate co mean + rate:mean o 1 phut.
# Phai dat TRUOC stack.sh: Gnocchi khong doi granularity cua metric da tao.
GNOCCHI_ARCHIVE_POLICY=ceilometer-high-rate
LIBS_FROM_GIT=python-octaviaclient,gnocchi
GNOCCHI_BRANCH=REPLACE_WITH_RECORDED_GNOCCHI_SHA
enable_plugin aodh https://opendev.org/openstack/aodh stable/2026.1
enable_plugin ceilometer https://opendev.org/openstack/ceilometer stable/2026.1

[[post-config|$NOVA_CONF]]
[DEFAULT]
reserved_host_memory_mb=16384
reserved_host_cpus=4
cpu_allocation_ratio=1.0
ram_allocation_ratio=1.0
disk_allocation_ratio=1.0
# Bat lai VM sau stop/start EC2 (mac dinh False -> VM SHUTOFF). n-cpu doc nova-cpu.conf (DevStack copy tu nova.conf).
resume_guests_state_on_host_boot=True

[[post-config|$NEUTRON_CONF]]
[DEFAULT]
global_physnet_mtu=1500

[[post-config|/$Q_PLUGIN_CONF_FILE]]
[ml2]
path_mtu=1500
[ml2_type_geneve]
max_header_size=38

# Octavia mac dinh provider amphora; lab tat o-cw/o-hm nen LB quen --provider ovn se ket PENDING_CREATE.
# Kiem sau stack.sh: grep -A4 '^\[api_settings\]' /etc/octavia/octavia.conf
[[post-config|$OCTAVIA_CONF]]
[api_settings]
default_provider_driver=ovn
