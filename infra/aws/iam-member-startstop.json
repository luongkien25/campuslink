{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "XemTrangThai",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:DescribeInstanceStatus"],
      "Resource": "*"
    },
    {
      "Sid": "BatTatHaiHostCampusLink",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:StopInstances"],
      "Resource": "arn:aws:ec2:us-east-1:*:instance/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/Project": "CampusLink" } }
    }
  ]
}
